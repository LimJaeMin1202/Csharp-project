<Window x:Class="StudyPlanner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StudyPlanner"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="망각곡선 학습 플래너" Height="720" Width="1080"
        WindowStartupLocation="CenterScreen"
        FontFamily="맑은 고딕" FontSize="14"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        KeyDown="Window_KeyDown">

    <TabControl x:Name="tabMain" Margin="10">

        <!-- ============ 탭 0: 대시보드 ============ -->
        <TabItem>
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ViewDashboardOutline" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="대시보드" VerticalAlignment="Center"/>
                </StackPanel>
            </TabItem.Header>
            <Grid Margin="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 요약 카드 4개 (학습 주제 / 오늘 복습 / 다가오는 시험 / 연속 학습) -->
                <Grid Grid.Row="0" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <materialDesign:Card Grid.Column="0" Background="#3F51B5" UniformCornerRadius="8"
                                         Padding="18" Margin="0,0,6,0"
                                         Cursor="Hand" ToolTip="등록된 학습 주제 총 개수 (클릭 → 학습 주제 탭)"
                                         MouseLeftButtonUp="CardLearnTopics_Click">
                        <StackPanel>
                            <TextBlock Text="학습 주제" Foreground="White" FontSize="13" Opacity="0.85"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock x:Name="txtTotalTopics" Text="0" Foreground="White"
                                           FontSize="36" FontWeight="Bold"/>
                                <TextBlock Text="개 등록됨" Foreground="White" FontSize="12" Opacity="0.85"
                                           VerticalAlignment="Bottom" Margin="6,0,0,8"/>
                            </StackPanel>
                        </StackPanel>
                    </materialDesign:Card>

                    <materialDesign:Card Grid.Column="1" Background="#E91E63" UniformCornerRadius="8"
                                         Padding="18" Margin="3,0,3,0"
                                         Cursor="Hand" ToolTip="오늘 복습할 항목 수 (클릭 → 오늘의 복습 탭)"
                                         MouseLeftButtonUp="CardTodayReview_Click">
                        <StackPanel>
                            <TextBlock Text="오늘 복습" Foreground="White" FontSize="13" Opacity="0.85"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock x:Name="txtTodayReview" Text="0" Foreground="White"
                                           FontSize="36" FontWeight="Bold"/>
                                <TextBlock Text="건 예정" Foreground="White" FontSize="12" Opacity="0.85"
                                           VerticalAlignment="Bottom" Margin="6,0,0,8"/>
                            </StackPanel>
                        </StackPanel>
                    </materialDesign:Card>

                    <materialDesign:Card Grid.Column="2" Background="#009688" UniformCornerRadius="8"
                                         Padding="18" Margin="3,0,3,0"
                                         Cursor="Hand" ToolTip="가장 가까운 시험까지 남은 일수 (클릭 → 시험 D-Day 탭)"
                                         MouseLeftButtonUp="CardNextExam_Click">
                        <StackPanel>
                            <TextBlock Text="다가오는 시험" Foreground="White" FontSize="13" Opacity="0.85"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock x:Name="txtNextExamDay" Text="—" Foreground="White"
                                           FontSize="36" FontWeight="Bold"/>
                                <TextBlock x:Name="txtNextExamLabel" Text="등록된 시험 없음"
                                           Foreground="White" FontSize="12" Opacity="0.85"
                                           VerticalAlignment="Bottom" Margin="6,0,0,8"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </materialDesign:Card>

                    <materialDesign:Card Grid.Column="3" Background="#FF6F00" UniformCornerRadius="8"
                                         Padding="18" Margin="6,0,0,0"
                                         Cursor="Hand" ToolTip="오늘부터 거꾸로 매일 학습한 일수 (클릭 → 통계 탭)"
                                         MouseLeftButtonUp="CardStreak_Click">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔥 연속 학습" Foreground="White" FontSize="13" Opacity="0.9"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock x:Name="txtStreak" Text="0" Foreground="White"
                                           FontSize="36" FontWeight="Bold"/>
                                <TextBlock Text="일 연속!" Foreground="White" FontSize="12" Opacity="0.85"
                                           VerticalAlignment="Bottom" Margin="6,0,0,8"/>
                            </StackPanel>
                        </StackPanel>
                    </materialDesign:Card>
                </Grid>

                <!-- 우하단 구석: 유틸리티 아이콘 버튼들 (가져오기/내보내기/테마/알림) -->
                <StackPanel Grid.Row="2" Orientation="Horizontal"
                            HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button x:Name="btnImport" Click="btnImport_Click"
                            Style="{StaticResource MaterialDesignIconButton}"
                            ToolTip="JSON 파일에서 데이터 가져오기 (복원)">
                        <materialDesign:PackIcon Kind="Import" Width="20" Height="20"/>
                    </Button>
                    <Button x:Name="btnExport" Click="btnExport_Click"
                            Style="{StaticResource MaterialDesignIconButton}"
                            ToolTip="JSON 파일로 데이터 내보내기 (백업)">
                        <materialDesign:PackIcon Kind="Export" Width="20" Height="20"/>
                    </Button>
                    <Button x:Name="btnTheme" Click="btnTheme_Click"
                            Style="{StaticResource MaterialDesignIconButton}"
                            ToolTip="다크모드 / 라이트모드 전환">
                        <materialDesign:PackIcon x:Name="iconTheme" Kind="WeatherNight" Width="20" Height="20"/>
                    </Button>
                    <Button x:Name="btnSettings" Click="btnSettings_Click"
                            Style="{StaticResource MaterialDesignIconButton}"
                            ToolTip="자동 알림 설정">
                        <materialDesign:PackIcon Kind="CogOutline" Width="20" Height="20"/>
                    </Button>
                    <Button x:Name="btnNotify" Click="btnNotify_Click"
                            Style="{StaticResource MaterialDesignIconButton}"
                            ToolTip="지금 알림 받기 (시연용)">
                        <materialDesign:PackIcon Kind="BellOutline" Width="20" Height="20"/>
                    </Button>
                </StackPanel>

                <!-- 차트 2개 -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <materialDesign:Card Grid.Column="0" UniformCornerRadius="8" Padding="14" Margin="0,0,8,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="과목별 학습 주제 분포"
                                       FontSize="15" FontWeight="Bold" Margin="0,0,0,2"/>
                            <TextBlock DockPanel.Dock="Top"
                                       Text="등록한 학습 주제를 과목별로 묶어서 보여줍니다."
                                       FontSize="11" Foreground="#666" Margin="0,0,0,8"
                                       TextWrapping="Wrap"/>
                            <lvc:CartesianChart x:Name="chartSubject"/>
                        </DockPanel>
                    </materialDesign:Card>

                    <materialDesign:Card Grid.Column="1" UniformCornerRadius="8" Padding="14" Margin="8,0,0,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="향후 14일 복습 일정"
                                       FontSize="15" FontWeight="Bold" Margin="0,0,0,2"/>
                            <TextBlock DockPanel.Dock="Top"
                                       Text="다음 2주간 매일 몇 개의 주제를 복습해야 하는지 보여줍니다. SM-2 알고리즘이 자동으로 분산해 배치합니다."
                                       FontSize="11" Foreground="#666" Margin="0,0,0,8"
                                       TextWrapping="Wrap"/>
                            <lvc:CartesianChart x:Name="chartSchedule"/>
                        </DockPanel>
                    </materialDesign:Card>
                </Grid>
            </Grid>
        </TabItem>

        <!-- ============ 탭 1: 학습 주제 ============ -->
        <TabItem>
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="BookOpenPageVariantOutline" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="학습 주제" VerticalAlignment="Center"/>
                </StackPanel>
            </TabItem.Header>
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 왼쪽: 학습 주제 입력 폼 -->
                <materialDesign:Card Grid.Column="0" UniformCornerRadius="8" Padding="20" Margin="0,0,10,0">
                    <StackPanel KeyDown="TopicForm_KeyDown">
                        <TextBlock Text="학습 주제 등록" FontSize="18" FontWeight="Bold" Margin="0,0,0,18"/>

                        <TextBox x:Name="txtSubject"
                                 Style="{StaticResource MaterialDesignFilledTextBox}"
                                 materialDesign:HintAssist.Hint="과목"
                                 Margin="0,0,0,14"/>

                        <TextBox x:Name="txtUnit"
                                 Style="{StaticResource MaterialDesignFilledTextBox}"
                                 materialDesign:HintAssist.Hint="단원 / 주제"
                                 Margin="0,0,0,14"/>

                        <DatePicker x:Name="dpStudyDate"
                                    Style="{StaticResource MaterialDesignFilledDatePicker}"
                                    materialDesign:HintAssist.Hint="학습일"
                                    Margin="0,0,0,14"/>

                        <TextBox x:Name="txtMemo"
                                 Style="{StaticResource MaterialDesignFilledTextBox}"
                                 materialDesign:HintAssist.Hint="메모"
                                 Margin="0,0,0,20" Height="92"
                                 TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"/>

                        <Button x:Name="btnAdd" Click="btnAdd_Click"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Height="42">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Plus" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="등록"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </materialDesign:Card>

                <!-- 오른쪽: 등록된 학습 주제 목록 -->
                <DockPanel Grid.Column="1">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="등록된 학습 주제" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="행 더블클릭 = 편집  ·  휴지통 = 삭제"
                                   FontSize="11" Foreground="#888"
                                   HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                    </Grid>

                    <!-- 검색 + 과목 필터 + 초기화 -->
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="txtSearch" Grid.Column="0"
                                 Style="{StaticResource MaterialDesignFilledTextBox}"
                                 materialDesign:HintAssist.Hint="과목 · 단원 · 메모 검색"
                                 materialDesign:TextFieldAssist.HasClearButton="True"
                                 Margin="0,0,8,0"
                                 TextChanged="txtSearch_TextChanged"/>
                        <ComboBox x:Name="cmbSubjectFilter" Grid.Column="1"
                                  Style="{StaticResource MaterialDesignFilledComboBox}"
                                  materialDesign:HintAssist.Hint="과목 필터"
                                  Margin="0,0,8,0"
                                  SelectionChanged="cmbSubjectFilter_SelectionChanged"/>
                        <Button Grid.Column="2" Click="btnClearFilter_Click"
                                Style="{StaticResource MaterialDesignIconButton}"
                                ToolTip="필터 초기화"
                                VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="FilterRemoveOutline" Width="20" Height="20"/>
                        </Button>
                        <TextBlock x:Name="txtFilterResultCount" Grid.Column="3"
                                   VerticalAlignment="Center" Margin="6,0,0,0"
                                   FontSize="12" Foreground="#666"/>
                    </Grid>

                    <Grid>
                        <DataGrid x:Name="dgTopics"
                              Style="{StaticResource MaterialDesignDataGrid}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" CanUserSortColumns="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" RowHeight="40"
                              MouseDoubleClick="dgTopics_MouseDoubleClick"
                              PreviewKeyDown="dgTopics_PreviewKeyDown">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="8" CanUserResize="False" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Rectangle Width="4" Margin="2,2,2,2"
                                                   Fill="{Binding Subject, Converter={StaticResource SubjectColorConverter}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="과목" Binding="{Binding Subject}" Width="100"/>
                            <DataGridTextColumn Header="단원/주제" Binding="{Binding Unit}" Width="*"/>
                            <DataGridTextColumn Header="학습일"
                                                Binding="{Binding StudyDate, StringFormat=yyyy/MM/dd}" Width="100"/>
                            <DataGridTextColumn Header="다음 복습일"
                                                Binding="{Binding NextReviewDate, StringFormat=yyyy/MM/dd}" Width="100"/>
                            <DataGridTextColumn Header="반복"
                                                Binding="{Binding RepetitionCount}" Width="50"/>
                            <DataGridTemplateColumn Header="" Width="44">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                                Click="btnDeleteTopic_Click"
                                                ToolTip="삭제"
                                                Padding="2" Width="32" Height="32"
                                                Foreground="#B71C1C">
                                            <materialDesign:PackIcon Kind="DeleteOutline" Width="18" Height="18"/>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                        <!-- 빈 상태 안내 (DataGrid 위에 오버레이) -->
                        <StackPanel x:Name="emptyTopics" VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="Collapsed" IsHitTestVisible="False">
                            <materialDesign:PackIcon Kind="BookOpenPageVariantOutline" Width="64" Height="64"
                                                     Foreground="#BDBDBD" HorizontalAlignment="Center"/>
                            <TextBlock Text="등록된 학습 주제가 없습니다" Foreground="#888"
                                       FontSize="15" Margin="0,12,0,4" HorizontalAlignment="Center"/>
                            <TextBlock Text="좌측 폼에서 첫 주제를 추가해보세요  (Ctrl+N)"
                                       Foreground="#AAA" FontSize="12" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Grid>
        </TabItem>

        <!-- ============ 탭 2: 오늘의 복습 ============ -->
        <TabItem>
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ClockCheckOutline" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="오늘의 복습" VerticalAlignment="Center"/>
                </StackPanel>
            </TabItem.Header>
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="310"/>
                </Grid.ColumnDefinitions>

                <!-- 왼쪽: 오늘 복습할 항목 목록 -->
                <DockPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock DockPanel.Dock="Top" x:Name="txtReviewCount"
                               Text="오늘 복습할 항목" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                    <Grid>
                    <DataGrid x:Name="dgReview"
                              Style="{StaticResource MaterialDesignDataGrid}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" SelectionMode="Single"
                              CanUserSortColumns="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="36"
                              SelectionChanged="dgReview_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="8" CanUserResize="False" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Rectangle Width="4" Margin="2,2,2,2"
                                                   Fill="{Binding Subject, Converter={StaticResource SubjectColorConverter}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="과목" Binding="{Binding Subject}" Width="100"/>
                            <DataGridTextColumn Header="단원/주제" Binding="{Binding Unit}" Width="*"/>
                            <DataGridTextColumn Header="복습 예정일"
                                                Binding="{Binding NextReviewDate, StringFormat=yyyy/MM/dd}" Width="110"/>
                            <DataGridTextColumn Header="반복" Binding="{Binding RepetitionCount}" Width="50"/>
                        </DataGrid.Columns>
                    </DataGrid>
                        <StackPanel x:Name="emptyReview" VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="Collapsed" IsHitTestVisible="False">
                            <materialDesign:PackIcon Kind="CheckCircleOutline" Width="64" Height="64"
                                                     Foreground="#A5D6A7" HorizontalAlignment="Center"/>
                            <TextBlock Text="오늘 복습할 항목이 없습니다 ✨" Foreground="#888"
                                       FontSize="15" Margin="0,12,0,4" HorizontalAlignment="Center"/>
                            <TextBlock Text="새 학습 주제를 등록하거나 잠시 쉬어가세요"
                                       Foreground="#AAA" FontSize="12" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </DockPanel>

                <!-- 오른쪽: 자가 평가 패널 -->
                <materialDesign:Card Grid.Column="1" UniformCornerRadius="8" Padding="18">
                    <StackPanel>
                        <TextBlock Text="자가 평가" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBlock x:Name="txtSelected" Text="복습할 항목을 선택하세요."
                                   TextWrapping="Wrap" Margin="0,0,0,16" Foreground="#666"/>
                        <TextBlock Text="이번 복습, 얼마나 기억났나요?"
                                   Margin="0,0,0,10" FontWeight="Bold"/>

                        <Button Content="5 — 완벽하게 기억남" Tag="5" Click="btnRate_Click"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Foreground="#2E7D32" BorderBrush="#2E7D32"
                                Margin="0,0,0,6" Height="36"
                                HorizontalContentAlignment="Left" Padding="14,0"/>
                        <Button Content="4 — 약간 머뭇거림" Tag="4" Click="btnRate_Click"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Foreground="#43A047" BorderBrush="#43A047"
                                Margin="0,0,0,6" Height="36"
                                HorizontalContentAlignment="Left" Padding="14,0"/>
                        <Button Content="3 — 어렵게 기억함" Tag="3" Click="btnRate_Click"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Foreground="#EF6C00" BorderBrush="#EF6C00"
                                Margin="0,0,0,6" Height="36"
                                HorizontalContentAlignment="Left" Padding="14,0"/>
                        <Button Content="2 — 가물가물 (실패)" Tag="2" Click="btnRate_Click"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Foreground="#E53935" BorderBrush="#E53935"
                                Margin="0,0,0,6" Height="36"
                                HorizontalContentAlignment="Left" Padding="14,0"/>
                        <Button Content="1 — 거의 못함 (실패)" Tag="1" Click="btnRate_Click"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Foreground="#C62828" BorderBrush="#C62828"
                                Margin="0,0,0,6" Height="36"
                                HorizontalContentAlignment="Left" Padding="14,0"/>
                        <Button Content="0 — 전혀 모름 (실패)" Tag="0" Click="btnRate_Click"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Foreground="#B71C1C" BorderBrush="#B71C1C"
                                Margin="0,0,0,6" Height="36"
                                HorizontalContentAlignment="Left" Padding="14,0"/>
                    </StackPanel>
                </materialDesign:Card>
            </Grid>
        </TabItem>

        <!-- ============ 탭 3: 시험 D-Day ============ -->
        <TabItem>
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="CalendarStar" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="시험 D-Day" VerticalAlignment="Center"/>
                </StackPanel>
            </TabItem.Header>
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 왼쪽: 시험 등록 + 일정 생성 -->
                <materialDesign:Card Grid.Column="0" UniformCornerRadius="8" Padding="20" Margin="0,0,10,0">
                    <StackPanel KeyDown="ExamForm_KeyDown">
                        <TextBlock Text="시험 등록" FontSize="18" FontWeight="Bold" Margin="0,0,0,18"/>

                        <TextBox x:Name="txtExamSubject"
                                 Style="{StaticResource MaterialDesignFilledTextBox}"
                                 materialDesign:HintAssist.Hint="과목"
                                 Margin="0,0,0,14"/>

                        <TextBox x:Name="txtExamName"
                                 Style="{StaticResource MaterialDesignFilledTextBox}"
                                 materialDesign:HintAssist.Hint="시험명 (예: 중간고사)"
                                 Margin="0,0,0,14"/>

                        <DatePicker x:Name="dpExamDate"
                                    Style="{StaticResource MaterialDesignFilledDatePicker}"
                                    materialDesign:HintAssist.Hint="시험일"
                                    Margin="0,0,0,18"/>

                        <Button x:Name="btnAddExam" Click="btnAddExam_Click"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Height="42" Margin="0,0,0,20">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CalendarPlus" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="시험 등록"/>
                            </StackPanel>
                        </Button>

                        <Separator Margin="0,0,0,12"/>
                        <TextBlock Text="목록에서 시험을 선택한 뒤 누르면, 해당 과목 학습 주제들의 복습 일정을 시험일 기준으로 재배치합니다."
                                   TextWrapping="Wrap" Foreground="#666" FontSize="12" Margin="0,0,0,10"/>

                        <Button x:Name="btnGenPlan" Click="btnGenPlan_Click"
                                Style="{StaticResource MaterialDesignRaisedSecondaryButton}"
                                Height="42">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CalendarClock" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="시험 대비 복습 일정 생성"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </materialDesign:Card>

                <!-- 오른쪽: 시험 목록 (D-Day) -->
                <DockPanel Grid.Column="1">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="등록된 시험" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="행 더블클릭 = 편집  ·  휴지통 = 삭제"
                                   FontSize="11" Foreground="#888"
                                   HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                    </Grid>

                    <!-- 검색 + 과목 필터 + 초기화 -->
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="txtExamSearch" Grid.Column="0"
                                 Style="{StaticResource MaterialDesignFilledTextBox}"
                                 materialDesign:HintAssist.Hint="시험명 · 과목 검색"
                                 materialDesign:TextFieldAssist.HasClearButton="True"
                                 Margin="0,0,8,0"
                                 TextChanged="txtExamSearch_TextChanged"/>
                        <ComboBox x:Name="cmbExamSubjectFilter" Grid.Column="1"
                                  Style="{StaticResource MaterialDesignFilledComboBox}"
                                  materialDesign:HintAssist.Hint="과목 필터"
                                  Margin="0,0,8,0"
                                  SelectionChanged="cmbExamSubjectFilter_SelectionChanged"/>
                        <Button Grid.Column="2" Click="btnClearExamFilter_Click"
                                Style="{StaticResource MaterialDesignIconButton}"
                                ToolTip="필터 초기화"
                                VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="FilterRemoveOutline" Width="20" Height="20"/>
                        </Button>
                        <TextBlock x:Name="txtExamFilterResultCount" Grid.Column="3"
                                   VerticalAlignment="Center" Margin="6,0,0,0"
                                   FontSize="12" Foreground="#666"/>
                    </Grid>

                    <Grid>
                    <DataGrid x:Name="dgExams"
                              Style="{StaticResource MaterialDesignDataGrid}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" CanUserSortColumns="True"
                              SelectionMode="Single"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="40"
                              MouseDoubleClick="dgExams_MouseDoubleClick"
                              PreviewKeyDown="dgExams_PreviewKeyDown">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="8" CanUserResize="False" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Rectangle Width="4" Margin="2,2,2,2"
                                                   Fill="{Binding Subject, Converter={StaticResource SubjectColorConverter}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="D-Day" Binding="{Binding DDayText}" Width="80"/>
                            <DataGridTextColumn Header="과목" Binding="{Binding Subject}" Width="120"/>
                            <DataGridTextColumn Header="시험명" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="시험일"
                                                Binding="{Binding ExamDate, StringFormat=yyyy/MM/dd}" Width="110"/>
                            <DataGridTemplateColumn Header="" Width="44">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                                Click="btnDeleteExam_Click"
                                                ToolTip="삭제"
                                                Padding="2" Width="32" Height="32"
                                                Foreground="#B71C1C">
                                            <materialDesign:PackIcon Kind="DeleteOutline" Width="18" Height="18"/>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                        <StackPanel x:Name="emptyExams" VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="Collapsed" IsHitTestVisible="False">
                            <materialDesign:PackIcon Kind="CalendarBlankOutline" Width="64" Height="64"
                                                     Foreground="#BDBDBD" HorizontalAlignment="Center"/>
                            <TextBlock Text="등록된 시험이 없습니다" Foreground="#888"
                                       FontSize="15" Margin="0,12,0,4" HorizontalAlignment="Center"/>
                            <TextBlock Text="좌측 폼에서 시험 일정을 추가해보세요  (Ctrl+E)"
                                       Foreground="#AAA" FontSize="12" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Grid>
        </TabItem>

        <!-- ============ 탭 4: 포모도로 타이머 ============ -->
        <TabItem>
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="TimerOutline" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="포모도로" VerticalAlignment="Center"/>
                </StackPanel>
            </TabItem.Header>
            <Grid Margin="15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="340"/>
                </Grid.ColumnDefinitions>

                <!-- 왼쪽: 타이머 본체 -->
                <materialDesign:Card Grid.Column="0" UniformCornerRadius="12" Padding="40" Margin="0,0,10,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="txtPomodoroMode" Text="집중 시간"
                                   FontSize="18" Foreground="#5C6BC0" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <TextBlock x:Name="txtPomodoroTime" Text="25:00"
                                   FontSize="96" FontWeight="Light"
                                   HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock x:Name="txtPomodoroStatus" Text="시작 버튼을 눌러 집중을 시작하세요"
                                   FontSize="13" Foreground="#888"
                                   HorizontalAlignment="Center" Margin="0,0,0,30"/>

                        <!-- 모드 선택 -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                            <Button x:Name="btnModeFocus" Content="집중 25분" Tag="25"
                                    Click="btnPomodoroMode_Click"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Foreground="#5C6BC0" BorderBrush="#5C6BC0"
                                    Margin="0,0,8,0" Padding="14,4"/>
                            <Button x:Name="btnModeShort" Content="짧은 휴식 5분" Tag="5"
                                    Click="btnPomodoroMode_Click"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Foreground="#26A69A" BorderBrush="#26A69A"
                                    Margin="0,0,8,0" Padding="14,4"/>
                            <Button x:Name="btnModeLong" Content="긴 휴식 15분" Tag="15"
                                    Click="btnPomodoroMode_Click"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Foreground="#FFA726" BorderBrush="#FFA726"
                                    Padding="14,4"/>
                        </StackPanel>

                        <!-- 조작 버튼 -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button x:Name="btnPomodoroStart" Click="btnPomodoroStart_Click"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Height="44" Width="120" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Play" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="시작"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnPomodoroPause" Click="btnPomodoroPause_Click"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Height="44" Width="120" Margin="0,0,8,0" IsEnabled="False">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Pause" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="일시정지"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnPomodoroReset" Click="btnPomodoroReset_Click"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    Height="44" Width="120">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Restart" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="리셋"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </materialDesign:Card>

                <!-- 오른쪽: 누적 통계 + 안내 -->
                <materialDesign:Card Grid.Column="1" UniformCornerRadius="12" Padding="20">
                    <StackPanel>
                        <TextBlock Text="포모도로 기법" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#666" FontSize="12" Margin="0,0,0,20">
                            <Run Text="25분 집중 → 5분 휴식 사이클을 반복하는 시간 관리법입니다."/>
                            <LineBreak/>
                            <Run Text="4회 사이클마다 긴 휴식(15분)을 권장합니다."/>
                        </TextBlock>

                        <Separator Margin="0,0,0,16"/>

                        <TextBlock Text="📊 오늘 집중" FontWeight="Bold" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock x:Name="txtTodaySessions" Text="0" FontSize="28" FontWeight="Bold" Foreground="#5C6BC0"/>
                            <TextBlock Text="회" Foreground="#888" VerticalAlignment="Bottom" Margin="3,0,12,5"/>
                            <TextBlock x:Name="txtTodayMinutes" Text="0" FontSize="28" FontWeight="Bold" Foreground="#5C6BC0"/>
                            <TextBlock Text="분" Foreground="#888" VerticalAlignment="Bottom" Margin="3,0,0,5"/>
                        </StackPanel>

                        <Separator Margin="0,16,0,16"/>

                        <TextBlock Text="📈 이번 주 (월~)" FontWeight="Bold" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock x:Name="txtWeekSessions" Text="0" FontSize="28" FontWeight="Bold" Foreground="#26A69A"/>
                            <TextBlock Text="회" Foreground="#888" VerticalAlignment="Bottom" Margin="3,0,12,5"/>
                            <TextBlock x:Name="txtWeekMinutes" Text="0" FontSize="28" FontWeight="Bold" Foreground="#26A69A"/>
                            <TextBlock Text="분" Foreground="#888" VerticalAlignment="Bottom" Margin="3,0,0,5"/>
                        </StackPanel>

                        <Separator Margin="0,16,0,16"/>

                        <TextBlock Text="💡 팁" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#888" FontSize="12">
                            집중 세션 완료 시 자동으로 기록됩니다. 트레이 알림과 시스템 소리로 알려줍니다.
                        </TextBlock>
                    </StackPanel>
                </materialDesign:Card>
            </Grid>
        </TabItem>

        <!-- ============ 탭 5: 월간 캘린더 ============ -->
        <TabItem>
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="CalendarMonthOutline" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="캘린더" VerticalAlignment="Center"/>
                </StackPanel>
            </TabItem.Header>
            <Grid Margin="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 상단 네비게이션 -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Click="btnCalendarPrev_Click"
                            Style="{StaticResource MaterialDesignIconButton}"
                            ToolTip="이전 달">
                        <materialDesign:PackIcon Kind="ChevronLeft" Width="24" Height="24"/>
                    </Button>
                    <TextBlock Grid.Column="1" x:Name="txtCalendarTitle" Text="2026년 5월"
                               FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Click="btnCalendarToday_Click"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Margin="0,0,6,0" Padding="14,4">
                        <TextBlock Text="오늘"/>
                    </Button>
                    <Button Grid.Column="3" Click="btnCalendarNext_Click"
                            Style="{StaticResource MaterialDesignIconButton}"
                            ToolTip="다음 달">
                        <materialDesign:PackIcon Kind="ChevronRight" Width="24" Height="24"/>
                    </Button>
                </Grid>

                <!-- 요일 헤더 -->
                <UniformGrid Grid.Row="1" Columns="7" Margin="0,0,0,4">
                    <TextBlock Text="월" HorizontalAlignment="Center" FontWeight="Bold" Foreground="#666"/>
                    <TextBlock Text="화" HorizontalAlignment="Center" FontWeight="Bold" Foreground="#666"/>
                    <TextBlock Text="수" HorizontalAlignment="Center" FontWeight="Bold" Foreground="#666"/>
                    <TextBlock Text="목" HorizontalAlignment="Center" FontWeight="Bold" Foreground="#666"/>
                    <TextBlock Text="금" HorizontalAlignment="Center" FontWeight="Bold" Foreground="#666"/>
                    <TextBlock Text="토" HorizontalAlignment="Center" FontWeight="Bold" Foreground="#2196F3"/>
                    <TextBlock Text="일" HorizontalAlignment="Center" FontWeight="Bold" Foreground="#E53935"/>
                </UniformGrid>

                <!-- 날짜 셀 그리드 -->
                <ItemsControl Grid.Row="2" x:Name="calendarGrid">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="7"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#E0E0E0" BorderThickness="0.5"
                                    Margin="1" Padding="6"
                                    ToolTip="{Binding TooltipText}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                                                <Setter Property="Background" Value="#FAFAFA"/>
                                                <Setter Property="Opacity" Value="0.5"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                <Setter Property="Background" Value="#FFF8E1"/>
                                                <Setter Property="BorderBrush" Value="#FFA726"/>
                                                <Setter Property="BorderThickness" Value="2"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HasExam}" Value="True">
                                                <Setter Property="Background" Value="#FFEBEE"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <TextBlock Text="{Binding Day}" HorizontalAlignment="Left" VerticalAlignment="Top"
                                               FontWeight="Bold" FontSize="14">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#333"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsWeekend}" Value="True">
                                                        <Setter Property="Foreground" Value="#E53935"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                                                        <Setter Property="Foreground" Value="#BBB"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding ExamText}" FontSize="10"
                                                   Foreground="#C62828" FontWeight="Bold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding StudyText}" FontSize="10"
                                                       Foreground="#388E3C" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding ReviewText}" FontSize="10"
                                                       Foreground="#1976D2"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 하단 범례 -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <TextBlock Text="📚 학습 등록" FontSize="11" Foreground="#388E3C" Margin="0,0,12,0"/>
                    <TextBlock Text="🔁 복습 예정" FontSize="11" Foreground="#1976D2" Margin="0,0,12,0"/>
                    <TextBlock Text="📝 시험" FontSize="11" Foreground="#C62828" Margin="0,0,12,0"/>
                    <TextBlock Text="🟡 오늘" FontSize="11" Foreground="#FFA726"/>
                </StackPanel>
            </Grid>
        </TabItem>

        <!-- ============ 탭 6: 상세 통계 ============ -->
        <TabItem>
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ChartBoxOutline" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="통계" VerticalAlignment="Center"/>
                </StackPanel>
            </TabItem.Header>
            <Grid Margin="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 요약 카드 4개 -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <materialDesign:Card Grid.Column="0" Background="#5C6BC0" UniformCornerRadius="8"
                                         Padding="18" Margin="0,0,6,0">
                        <StackPanel>
                            <TextBlock Text="누적 학습 주제" Foreground="White" FontSize="13" Opacity="0.85"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock x:Name="txtStatTotal" Text="0" Foreground="White"
                                           FontSize="34" FontWeight="Bold"/>
                                <TextBlock Text="개" Foreground="White" FontSize="12" Opacity="0.85"
                                           VerticalAlignment="Bottom" Margin="4,0,0,7"/>
                            </StackPanel>
                        </StackPanel>
                    </materialDesign:Card>

                    <materialDesign:Card Grid.Column="1" Background="#26A69A" UniformCornerRadius="8"
                                         Padding="18" Margin="3,0,3,0">
                        <StackPanel>
                            <TextBlock Text="누적 복습 횟수" Foreground="White" FontSize="13" Opacity="0.85"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock x:Name="txtStatReviewCount" Text="0" Foreground="White"
                                           FontSize="34" FontWeight="Bold"/>
                                <TextBlock Text="회" Foreground="White" FontSize="12" Opacity="0.85"
                                           VerticalAlignment="Bottom" Margin="4,0,0,7"/>
                            </StackPanel>
                        </StackPanel>
                    </materialDesign:Card>

                    <materialDesign:Card Grid.Column="2" Background="#FFA726" UniformCornerRadius="8"
                                         Padding="18" Margin="3,0,3,0">
                        <StackPanel>
                            <TextBlock Text="30일 내 복습 예정" Foreground="White" FontSize="13" Opacity="0.85"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock x:Name="txtStatUpcoming30" Text="0" Foreground="White"
                                           FontSize="34" FontWeight="Bold"/>
                                <TextBlock Text="건" Foreground="White" FontSize="12" Opacity="0.85"
                                           VerticalAlignment="Bottom" Margin="4,0,0,7"/>
                            </StackPanel>
                        </StackPanel>
                    </materialDesign:Card>

                    <materialDesign:Card Grid.Column="3" Background="#EF5350" UniformCornerRadius="8"
                                         Padding="18" Margin="6,0,0,0">
                        <StackPanel>
                            <TextBlock Text="약점 주제 (EF&lt;2.0)" Foreground="White" FontSize="13" Opacity="0.85"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock x:Name="txtStatWeak" Text="0" Foreground="White"
                                           FontSize="34" FontWeight="Bold"/>
                                <TextBlock Text="개" Foreground="White" FontSize="12" Opacity="0.85"
                                           VerticalAlignment="Bottom" Margin="4,0,0,7"/>
                            </StackPanel>
                        </StackPanel>
                    </materialDesign:Card>
                </Grid>

                <!-- 차트 2개 (월별 / 요일별) -->
                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <materialDesign:Card Grid.Column="0" UniformCornerRadius="8" Padding="14" Margin="0,0,6,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="월별 학습 추이 (최근 6개월)"
                                       FontSize="14" FontWeight="Bold" Margin="0,0,0,2"/>
                            <TextBlock DockPanel.Dock="Top"
                                       Text="달마다 새로 등록한 학습 주제 수입니다."
                                       FontSize="11" Foreground="#888" Margin="0,0,0,8"/>
                            <lvc:CartesianChart x:Name="chartMonthly"/>
                        </DockPanel>
                    </materialDesign:Card>

                    <materialDesign:Card Grid.Column="1" UniformCornerRadius="8" Padding="14" Margin="6,0,0,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="요일별 학습 분포"
                                       FontSize="14" FontWeight="Bold" Margin="0,0,0,2"/>
                            <TextBlock DockPanel.Dock="Top"
                                       Text="어느 요일에 가장 많이 공부했는지 보여줍니다."
                                       FontSize="11" Foreground="#888" Margin="0,0,0,8"/>
                            <lvc:CartesianChart x:Name="chartDayOfWeek"/>
                        </DockPanel>
                    </materialDesign:Card>
                </Grid>

                <!-- 복습 진행도 + 약점 단원 Top 5 -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <materialDesign:Card Grid.Column="0" UniformCornerRadius="8" Padding="14" Margin="0,0,6,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="복습 진행도 분포"
                                       FontSize="14" FontWeight="Bold" Margin="0,0,0,2"/>
                            <TextBlock DockPanel.Dock="Top"
                                       Text="SM-2 알고리즘으로 각 주제를 몇 번 복습했는지 분포입니다."
                                       FontSize="11" Foreground="#888" Margin="0,0,0,8"
                                       TextWrapping="Wrap"/>
                            <lvc:CartesianChart x:Name="chartProgress"/>
                        </DockPanel>
                    </materialDesign:Card>

                    <materialDesign:Card Grid.Column="1" UniformCornerRadius="8" Padding="14" Margin="6,0,0,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="약점 단원 Top 5"
                                       FontSize="14" FontWeight="Bold" Margin="0,0,0,2"/>
                            <TextBlock DockPanel.Dock="Top"
                                       Text="난이도 계수(EF)가 가장 낮은 단원들입니다. 우선적으로 복습하세요."
                                       FontSize="11" Foreground="#888" Margin="0,0,0,8"
                                       TextWrapping="Wrap"/>
                            <DataGrid x:Name="dgWeakTopics"
                                      Style="{StaticResource MaterialDesignDataGrid}"
                                      AutoGenerateColumns="False" IsReadOnly="True"
                                      CanUserAddRows="False" HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal" RowHeight="34">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="" Width="8" CanUserResize="False" CanUserSort="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Rectangle Width="4" Margin="2,2,2,2"
                                                           Fill="{Binding Subject, Converter={StaticResource SubjectColorConverter}}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="과목" Binding="{Binding Subject}" Width="100"/>
                                    <DataGridTextColumn Header="단원/주제" Binding="{Binding Unit}" Width="*"/>
                                    <DataGridTextColumn Header="EF"
                                                        Binding="{Binding EaseFactor, StringFormat=F2}" Width="60"/>
                                    <DataGridTextColumn Header="복습"
                                                        Binding="{Binding RepetitionCount}" Width="50"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </materialDesign:Card>
                </Grid>
            </Grid>
        </TabItem>

    </TabControl>
</Window>
